# Copy to .env and fill in. Everything not listed here uses the default from
# outlook_xurrent/config.py; the full list of settings is in README.md.

# Xurrent: Personal Access Token with Allow / Request:Read (avatar > My Profile)
XURRENT_TOKEN=
# value of the X-Xurrent-Account header, usually the subdomain of your instance
XURRENT_ACCOUNT=
# hosts whose request links are trusted, comma separated (agent instance, customer portal)
XURRENT_INSTANCE_HOST=your-account.xurrent.com

# Outlook category names, spelled exactly as in your mailbox
OPEN_CATEGORY=To do,In progress
DONE_CATEGORY=Done
# optional: waiting-for-customer requests move their mails here (must be in OPEN_CATEGORY)
WAITING_CATEGORY=In progress
